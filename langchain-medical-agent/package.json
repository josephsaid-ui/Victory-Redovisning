  "description": "LangChain-baserad medicinsk agent för ögonsekreterare",
  "main": "src/agent/medical-agent.ts",
  "scripts": {
    "dev": "tsx watch src/agent/medical-agent.ts",
    "build": "tsc",
    "example:basic": "tsx examples/basic-example.ts",
    "example:streaming": "tsx examples/streaming-example.ts",
    "example:integration": "tsx examples/integration-example.ts",
    "test": "vitest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "@langchain/anthropic": "^0.3.0",
    "@langchain/core": "^0.3.0",
