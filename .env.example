# PostgreSQL Database Configuration
# Kopiera denna fil till .env och fyll i dina uppgifter

# Database connection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chat_history
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# Optional: Connection pool settings
# POSTGRES_MIN_CONN=1
# POSTGRES_MAX_CONN=10

# Optional: SSL settings (för produktionsmiljö)
# POSTGRES_SSLMODE=require
# POSTGRES_SSLCERT=/path/to/client-cert.pem
# POSTGRES_SSLKEY=/path/to/client-key.pem
# POSTGRES_SSLROOTCERT=/path/to/server-ca.pem

# Application settings
# LOG_LEVEL=INFO
# DEBUG=False
